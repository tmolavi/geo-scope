# GEO-Scope Environment Configuration Example
# Copy this file to .env or set variables in your shell / secret manager.
# NEVER commit actual API keys or secrets to git.

# Perplexity AI (Sonar / Sonar Pro - Search Grounded)
# Required for live Perplexity benchmarking
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro

# Google Gemini (Search Grounding Enabled)
# Required for live Google Gemini benchmarking
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (Direct Completion - Parametric Knowledge, Not Live Search Grounded)
# Required for live OpenAI benchmarking
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic Claude (Direct Completion - Parametric Knowledge, Not Live Search Grounded)
# Required for live Anthropic Claude benchmarking
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# Ollama Local Inference (Zero Cost, No API Key Required)
# Optional: defaults to http://localhost:11434 and deepseek-r1:14b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:14b

# OpenRouter Free Tier
# Optional
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Keyless Wrapper Local Endpoint
# Optional: user-run local OpenAI-compatible wrapper
KEYLESS_WRAPPER_HOST=http://127.0.0.1:8080
KEYLESS_WRAPPER_MODEL=keyless-gpt-4o-mini

# Public Research Endpoint Opt-In
# Optional: set to 1 to enable noncommercial public research endpoint
GEO_SCOPE_NONCOMMERCIAL=0

# Hamzad AI Gateway (Unified Multi-Provider Inference Gateway)
# Default gateway: https://api.molavi.pro
HAMZAD_GATEWAY_URL=https://api.molavi.pro
HAMZAD_PROJECT_ID=hamzad
HAMZAD_API_KEY=
HAMZAD_TIMEOUT=30.0

